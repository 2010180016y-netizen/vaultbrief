rules_version = '2';

// Receipts are written by the app after each brief and are readable only by the
// anonymous user that wrote them. Nothing else in the database is exposed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /receipts/{receiptId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'id', 'startedAt', 'policy', 'requestedMode', 'source', 'simulated',
                         'latencyMs', 'inputChars', 'cloudChars', 'stayedLocalChars',
                         'tokensIn', 'tokensOut', 'chunks', 'redacted', 'notes', 'uid', 'createdAt'
                       ]);
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
