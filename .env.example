# Copy to .env.local (never commit it).
#
# Firebase web app config. Public by design: it identifies the project, it does
# not authorise anything. App Check is what protects the Gemini quota.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check: use ONE of these.
# 1) reCAPTCHA Enterprise site key (production traffic)
VITE_APPCHECK_SITE_KEY=
# 2) A debug token registered in Firebase console > Security > App Check.
#    "true" mints a new token each session; a UUID keeps it stable.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional. Defaults to gemini-3.5-flash-lite (Remote Config can override it).
VITE_CLOUD_MODEL=
