{
  "name": "vaultbrief",
  "private": true,
  "version": "1.2.0",
  "description": "VaultBrief — hybrid on-device / cloud document briefings with Firebase AI Logic, WebLLM, transformers.js, a Presidio-grade PII layer and verifiable privacy receipts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty",
    "test": "node scripts/verify-oss.mjs && vitest run",
    "verify:extension": "node scripts/verify-extension.mjs",
    "verify:sdk": "node scripts/verify-sdk-path.mjs",
    "verify:receipt": "node scripts/verify-receipt.mjs --receipt evidence/receipt-sample.json --document evidence/receipt-sample-document.txt --previous bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "verify:oss": "node scripts/verify-oss.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:extension && npm run verify:receipt && npm run verify:oss",
    "icons": "node scripts/make-icons.mjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mlc-ai/web-llm": "^0.2.89",
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/dom-chromium-ai": "^0.0.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
