{
  "name": "vaultbrief",
  "private": true,
  "version": "1.0.0",
  "description": "VaultBrief — hybrid on-device / cloud document briefings built with Firebase AI Logic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit false --pretty",
    "test": "vitest run",
    "verify:sdk": "node scripts/verify-sdk-path.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/dom-chromium-ai": "^0.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^29.1.0",
    "typescript": "^5.9.4",
    "vite": "^8.1.4",
    "vitest": "^4.0.18"
  }
}
