{
  "manifest_version": 3,
  "name": "VaultBrief — brief the page you are reading",
  "short_name": "VaultBrief",
  "version": "1.0.1",
  "description": "Sends the readable text of the current tab to VaultBrief, which briefs it with Gemini Nano on-device or a cloud model through Firebase AI Logic.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Brief this page with VaultBrief",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "139"
}
